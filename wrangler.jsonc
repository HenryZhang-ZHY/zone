{
  "name": "zone",
  "compatibility_date": "2025-08-23",
  // Negotiates the language for the root URL only; every other request is a static asset.
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "routes": [
    {
      "pattern": "shuzhi.zone",
      "custom_domain": true
    }
  ]
}
