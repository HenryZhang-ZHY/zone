{
  "name": "zone",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "tokens": "bun run --filter @zone/tokens build",
    "design": "bun run --filter @zone/design dev",
    "design:build": "bun run --filter @zone/tokens build && bun run --filter @zone/design build",
    "design:preview": "bun run --filter @zone/design preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@zone/ui": "workspace:*",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "katex": "^0.19.1",
    "normalize.css": "^8.0.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
