---
// The root URL. In production the Worker sends each visitor to their language
// before this page is served; it remains the hreflang x-default target and the
// fallback for crawlers and local development.
import BaseHead from '../components/BaseHead.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { SITE_TITLE } from '../consts'
import { defaultLocale, localeTags, t } from '../i18n'
import { alternateLinks } from '../lib/localized'

const alternates = alternateLinks('/', localeTags, '/', Astro.site!)
---

<!doctype html>
<html lang={defaultLocale} dir="ltr">
	<head>
		<BaseHead title={SITE_TITLE} description={t(defaultLocale).siteDescription} locale={defaultLocale} canonicalURL={new URL('/', Astro.site)} alternates={alternates} />
	</head>
	<body class="z-page-shell z-page-shell--narrow">
		<main class="z-main language-picker">
			<h1 class="z-page-title">{SITE_TITLE}</h1>
			<LanguageSwitcher path="/" label={t(defaultLocale).language} />
		</main>
	</body>
</html>

<style>
	.language-picker {
		display: grid;
		justify-items: center;
		gap: var(--z-space-8);
		text-align: center;
	}
</style>
