---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../../consts'
import { getCollection } from 'astro:content'
import RunningHead from '@zone/ui/components/RunningHead.astro'
import RecordRow from '@zone/ui/components/RecordRow.astro'
import { localeStaticPaths, t, type Locale } from '../../i18n'
import { linkHost, sourceLabel, splitEpisodeCode } from '../../lib/records'
import { sortByOrder } from '../../lib/order'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const episodes = sortByOrder(await getCollection('podcast'))
---

<BaseLayout
  locale={locale}
  path="/listening/"
  title={`${i18n.listeningTitle} | ${SITE_TITLE}`}
  description={i18n.listeningDescription}
>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-measure">
      <RunningHead label={i18n.listening} count={i18n.listeningCount(episodes.length)} />
      <section aria-labelledby="episodes">
        <h2 id="episodes" class="sr-only">{i18n.listening}</h2>
        <ul class="m-0 list-none p-0">
          {
            episodes.map((episode) => {
              const { code, title } = splitEpisodeCode(episode.data.ogTitle)
              return (
                <RecordRow
                  lead={code}
                  title={title}
                  href={episode.data.ogUrl}
                  meta={episode.data.show}
                  source={sourceLabel(linkHost(episode.data.ogUrl))}
                  cover={episode.data.showCover}
                  kind="code"
                />
              )
            })
          }
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
