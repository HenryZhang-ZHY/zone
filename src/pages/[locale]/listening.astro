---
import { getCollection } from 'astro:content'
import AudioPlayer from '../../components/audio/AudioPlayer.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import { SITE_TITLE } from '../../consts'
import { localeStaticPaths, t, type Locale } from '../../i18n'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const episodes = await getCollection('podcast')
---

<BaseLayout
  locale={locale}
  path="/listening/"
  title={`${i18n.listeningTitle} | ${SITE_TITLE}`}
  description={i18n.listeningDescription}
>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-measure">
      <PageHeader title={i18n.listening} class="mb-8" />
      <section aria-labelledby="episodes">
        <h2 id="episodes" class="sr-only">{i18n.listening}</h2>
        {
          episodes.map((episode, index) => (
            <article class="border-t border-line py-5 last:border-b">
              <div class="grid gap-x-6 gap-y-3 sm:grid-cols-[2.25rem_minmax(0,1fr)_1rem]">
                <span class="pt-[0.35em] font-ui text-label-11 tabular-nums text-ink-quiet">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <div class="flex items-start justify-between gap-4">
                    <a
                      class="font-prose text-copy-18 text-ink underline decoration-transparent underline-offset-[0.18em] transition-[color,text-decoration-color] duration-1 ease-out hover:text-accent hover:decoration-current"
                      href={episode.data.ogUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {episode.data.ogTitle}
                    </a>
                    <span class="shrink-0 font-ui text-label-13 text-ink-quiet" aria-hidden="true">↗</span>
                  </div>
                  <p class="mt-1 font-ui text-label-12 text-ink-tertiary">{i18n.listeningTitle}</p>
                  <div class="mt-3">
                    <AudioPlayer src={episode.data.ogAudio} />
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>
</BaseLayout>
