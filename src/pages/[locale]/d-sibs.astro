---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LanguageNote from '../../components/LanguageNote.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import CompositionBar from '@zone/ui/components/CompositionBar.astro'
import EdgeToc from '@zone/ui/components/EdgeToc.astro'
import GroupMark from '@zone/ui/components/GroupMark.astro'
import BankHistoryTable from '../../components/d-sibs/BankHistoryTable.astro'
import ChangesTimeline from '../../components/d-sibs/ChangesTimeline.astro'
import DsibsSection from '../../components/d-sibs/DsibsSection.astro'
import SparklinePopover from '../../components/d-sibs/SparklinePopover.astro'
import YearCompositionGrid from '../../components/d-sibs/YearCompositionGrid.astro'
import { SITE_TITLE } from '../../consts'
import { getCollection } from 'astro:content'
import { buildDsibsViewModel, groupKeys, groupLabels, type YearStats } from '../../lib/d-sibs'
import { localeStaticPaths, type Locale } from '../../i18n'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }

const rawEntries = await getCollection('dsibs')
const { years, sortedBanks, yearStats, changes } = buildDsibsViewModel(
  rawEntries.map((entry) => entry.data),
)

const latest = yearStats.at(-1)
const previous = yearStats.at(-2)
const latestChange = changes.at(-1)
const groupOrder = [...groupKeys].reverse()
const latestGroups = latest ? groupOrder.filter((group) => latest.groups[group].length > 0) : []
const latestSegments = latest
  ? latestGroups.map((group) => ({ group, count: latest.groups[group].length }))
  : []
const latestDelta = latest && previous ? latest.total - previous.total : null
const latestChangeCount = latestChange
  ? latestChange.entered.length + latestChange.exited.length + latestChange.upgraded.length + latestChange.downgraded.length
  : 0
const description = `汇总中国人民银行发布的 ${years[0]}—${years.at(-1)} 年中国系统重要性银行名单，按附加监管要求分组展示，并追踪历次发布的入选和组别变化。`

const sections = [
  { id: 'comparison', index: '01', title: '历年规模' },
  { id: 'history', index: '02', title: '银行明细' },
  { id: 'changes', index: '03', title: '名单变化' },
  { id: 'annual-lists', index: '04', title: '各期名单' },
]

const compositionLabel = (stats: YearStats) =>
  `${stats.year} 年：${groupOrder
    .filter((group) => stats.groups[group].length > 0)
    .map((group) => `${groupLabels[group]} ${stats.groups[group].length} 家`)
    .join('，')}`

const deltaLabel = (delta: number | null) => (delta === null ? '—' : delta > 0 ? `+${delta}` : delta === 0 ? '±0' : String(delta))
---

<BaseLayout
  title={`系统重要性银行名单 | ${SITE_TITLE}`}
  description={description}
  locale={locale}
  path="/d-sibs/"
  available={['zh-Hans']}
  sourceLocale="zh-Hans"
>
  <main class="shell pt-article-top pb-page-bottom" lang="zh-Hans">
    <PageHeader
      class="max-sm:[&>h1]:text-heading-32 [&>p:first-child]:normal-case"
      eyebrow="数据观察 / D-SIBs"
      title="中国系统重要性银行"
      lede="按组别查看每家银行的入选轨迹。"
    >
      <LanguageNote
        slot="note"
        placement="inline"
        locale={locale}
        path="/d-sibs/"
        sourceLocale="zh-Hans"
        available={['zh-Hans'] as Locale[]}
      />
      <div slot="meta" class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-line pt-4 font-ui text-label-11 text-ink-tertiary">
        <span>{years.length} 期发布</span>
        <span>{years[0]}—{years.at(-1)}</span>
        {latest && <span class="text-ink">最新 {latest.year}</span>}
        {latest && (
          <a
            class="ml-auto text-accent underline decoration-accent/40 underline-offset-[0.25em] transition-colors duration-1 hover:decoration-current max-sm:ml-0"
            href={latest.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            查看央行公告 ↗
          </a>
        )}
      </div>
    </PageHeader>

    {latest && (
      <section aria-labelledby="latest-title" class="border-y border-line-strong">
        <h2 id="latest-title" class="sr-only">{latest.year} 年最新名单</h2>
        <div class="grid gap-10 py-8 lg:grid-cols-[minmax(0,1.55fr)_minmax(17rem,0.45fr)] lg:gap-0">
          <div class="lg:pr-10">
            <p class="font-ui text-label-11 tabular-nums text-ink-tertiary">{latest.year}</p>
            <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-2">
              <p class="font-prose text-display-64 leading-none tabular-nums text-ink">{latest.total}</p>
              <div class="pb-1">
                <p class="font-prose text-heading-24 text-ink">家银行入选</p>
                {previous && (
                  <p class="mt-1 font-ui text-label-12 tabular-nums text-ink-tertiary">
                    较 {previous.year} 年 {deltaLabel(latestDelta)} 家
                  </p>
                )}
              </div>
            </div>

            <CompositionBar
              segments={latestSegments}
              max={latest.total}
              label={`${latest.year} 年最新名单组别构成：${latestGroups.map((group) => `${groupLabels[group]} ${latest.groups[group].length} 家`).join('，')}`}
              class="mt-9 h-2"
            />

            <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-4">
              {latestGroups.map((group) => (
                <div class="flex items-baseline justify-between gap-3 border-t border-line pt-2">
                  <dt><GroupMark group={group} label={groupLabels[group]} srLabel={groupLabels[group]} /></dt>
                  <dd class="font-ui text-label-12 tabular-nums text-ink">
                    {latest.groups[group].length}<span class="ml-1 text-ink-tertiary">家</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>

          <aside class="border-t border-line pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <div class="flex items-baseline justify-between font-ui text-label-11 uppercase text-ink-tertiary">
              <span>发布记录</span>
              <span class="tabular-nums">{years.length} 期</span>
            </div>
            <ol class="mt-3">
              {yearStats.map((stats, index) => (
                <li class="grid grid-cols-[1.5rem_1fr_auto] items-baseline gap-3 border-t border-line py-2.5 first:border-t-0">
                  <span class="font-ui text-label-11 tabular-nums text-ink-quiet">{String(index + 1).padStart(2, '0')}</span>
                  <a
                    class={`font-prose text-heading-18 underline decoration-transparent underline-offset-[0.2em] transition-[color,text-decoration-color] duration-1 hover:text-accent hover:decoration-current ${
                      index === yearStats.length - 1 ? 'text-ink' : 'text-ink-secondary'
                    }`}
                    href={stats.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {stats.year}
                  </a>
                  <span class="font-ui text-label-11 tabular-nums text-ink-tertiary">{stats.total} 家</span>
                </li>
              ))}
            </ol>

            {latestChange && (
              <div class="mt-6 border-t border-line pt-4">
                <div class="flex items-baseline justify-between font-ui text-label-11 text-ink-tertiary">
                  <span>最近一次变化</span>
                  <span class="tabular-nums">{latestChangeCount} 项</span>
                </div>
                <a
                  class="mt-2 flex items-baseline justify-between gap-3 font-prose text-heading-18 text-ink underline decoration-transparent underline-offset-[0.2em] transition-[color,text-decoration-color] duration-1 hover:text-accent hover:decoration-current"
                  href="#changes"
                >
                  <span>{latestChange.from} → {latestChange.to}</span>
                  <span class="font-ui text-label-11 text-ink-tertiary">查看 →</span>
                </a>
              </div>
            )}

          </aside>
        </div>
      </section>
    )}

    <DsibsSection id="comparison" index="01" title="历年规模">
      <div class="border-t border-line-strong">
        {yearStats.map((stats, index) => {
          const previousStats = yearStats[index - 1]
          const delta = previousStats ? stats.total - previousStats.total : null
          const segments = groupOrder
            .filter((group) => stats.groups[group].length > 0)
            .map((group) => ({ group, count: stats.groups[group].length }))
          return (
            <div class="grid grid-cols-[3.5rem_3rem_minmax(0,1fr)_4rem] items-baseline gap-4 border-b border-line py-4 last:border-b-0 max-sm:grid-cols-[3.5rem_2.5rem_minmax(0,1fr)]">
              <a
                class={`font-ui text-label-13 tabular-nums underline decoration-transparent underline-offset-[0.2em] transition-[color,text-decoration-color] duration-1 hover:text-accent hover:decoration-current ${
                  index === yearStats.length - 1 ? 'text-ink' : 'text-ink-secondary'
                }`}
                href={stats.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {stats.year}
              </a>
              <span class="font-prose text-heading-24 tabular-nums text-ink">{stats.total}</span>
              <CompositionBar
                segments={segments}
                max={latest?.total}
                label={compositionLabel(stats)}
                class="h-1.5 self-center"
              />
              <span class="text-right font-ui text-label-12 tabular-nums text-ink-tertiary max-sm:hidden" aria-label={`较上期 ${deltaLabel(delta)}`}>{deltaLabel(delta)}</span>
            </div>
          )
        })}
      </div>
    </DsibsSection>

    <DsibsSection id="history" index="02" title="银行明细">
      <BankHistoryTable years={years} banks={sortedBanks} />
    </DsibsSection>
    <SparklinePopover />

    <DsibsSection id="changes" index="03" title="名单变化">
      <ChangesTimeline changes={changes} />
    </DsibsSection>

    <DsibsSection id="annual-lists" index="04" title="各期名单">
      <YearCompositionGrid yearStats={yearStats} />
    </DsibsSection>

    <p class="mt-16 border-t border-line pt-4 font-ui text-label-11 leading-[1.7] text-ink-tertiary">
      数据来源：<a
        class="text-accent underline decoration-accent/40 underline-offset-[0.25em] hover:decoration-current"
        href="https://www.pbc.gov.cn/huobizhengceersi/214481/3868581/3868587/index.html"
        target="_blank"
        rel="noopener noreferrer"
      >中国人民银行宏观审慎管理局</a>。
    </p>
  </main>

  <div class="max-[1319px]:hidden">
    <EdgeToc
      headings={sections.map((section) => ({ depth: 2, text: section.title, slug: section.id }))}
      label="本页导航"
    />
  </div>
</BaseLayout>
