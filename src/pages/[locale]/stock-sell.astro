---
import StockSellSheet from '../../components/stock-sell/StockSellSheet.astro'
import LanguageNote from '../../components/LanguageNote.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import { SITE_TITLE } from '../../consts'
import { localeStaticPaths, type Locale } from '../../i18n'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
---

<BaseLayout
  title={`股票卖点计算器 | ${SITE_TITLE}`}
  description="按目标股息率反推卖出价格：输入成本、持仓与每股分红，查看不同卖出股数对应的每股卖价。结果仅供估算，不构成投资建议。"
  locale={locale}
  path="/stock-sell/"
  available={['zh-Hans']}
  sourceLocale="zh-Hans"
>
  <main class="shell pt-article-top pb-page-bottom" lang="zh-Hans">
    <PageHeader
      eyebrow="工具 / 股息率"
      title="股票卖点计算器"
      lede="按目标股息率，反推卖出部分持仓所需的每股价格。"
    >
      <LanguageNote
        slot="note"
        placement="inline"
        locale={locale}
        path="/stock-sell/"
        sourceLocale="zh-Hans"
        available={['zh-Hans'] as Locale[]}
      />
    </PageHeader>

    <StockSellSheet />
  </main>
</BaseLayout>
