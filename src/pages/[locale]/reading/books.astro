---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../../../consts'
import Book from '@zone/ui/components/Book.astro'
import RunningHead from '@zone/ui/components/RunningHead.astro'
import { localeStaticPaths, t, type Locale } from '../../../i18n'
import { sortByOrder } from '../../../lib/order'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const books = sortByOrder(await getCollection('book'))
---

<BaseLayout
  locale={locale}
  path="/reading/books/"
  title={`${i18n.booksTitle} | ${SITE_TITLE}`}
  description={i18n.booksDescription}
>
  <main class="shell py-page-top pb-page-bottom">
    <RunningHead label={i18n.books} count={i18n.booksCount(books.length)} />
    <section aria-labelledby="books" class="mt-8">
      <h2 id="books" class="sr-only">{i18n.books}</h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-x-5 gap-y-8 max-sm:grid-cols-3 max-sm:gap-x-3 max-sm:gap-y-6">
        {
          books.map((book, index) => (
            <Book
              title={book.data.title}
              href={book.data.ogUrl}
              cover={book.data.ogImage.src}
              loading={index < 8 ? 'eager' : 'lazy'}
            />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
