---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import Book from '@zone/ui/components/Book.astro'
import { SITE_TITLE } from '../../../consts'
import { localeStaticPaths, t, type Locale } from '../../../i18n'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const books = await getCollection('book')
---

<BaseLayout
  locale={locale}
  path="/reading/books/"
  title={`${i18n.booksTitle} | ${SITE_TITLE}`}
  description={i18n.booksDescription}
>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-[66rem]">
      <PageHeader title={i18n.booksTitle} lede={i18n.booksSubtitle} class="mb-10" />
      <section aria-labelledby="books">
        <h2 id="books" class="sr-only">{i18n.booksTitle}</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-x-6 gap-y-10 max-sm:grid-cols-2 max-sm:gap-x-4 max-sm:gap-y-8">
          {books.map((book, index) => (
            <Book
              title={book.data.title}
              href={book.data.ogUrl}
              cover={book.data.ogImage.src}
              loading={index < 8 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
