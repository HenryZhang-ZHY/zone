---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LanguageNote from '../../components/LanguageNote.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import HolderTable from '../../components/shareholders/HolderTable.astro'
import DataNotes from '../../components/shareholders/DataNotes.astro'
import { buildPanelModel } from '../../lib/shareholders/model'
import { loadPanelRows } from '../../lib/shareholders/parse'
import { panelRowToTableRow, tableRowHtml } from '../../lib/shareholders/table'
import {
  PANEL_CSV_FILENAME,
  PANEL_CSV_URL,
  PANEL_JSON_URL,
} from '../../lib/shareholders/types'
import { formatCount, formatPercent } from '../../lib/shareholders/view'
import { SITE_TITLE } from '../../consts'
import { localeStaticPaths, localizePath, type Locale } from '../../i18n'
import '../../styles/shareholders.css'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }

const model = buildPanelModel(loadPanelRows())
const latestYear = model.latestYear
const latestRows = model.rows.filter((row) => row.year === latestYear)
const companiesByCode = new Map(model.companies.map((company) => [company.code, company]))

// The table's first paint is the latest year, in code order. The browser takes
// over search, sort, the year switch and the accordion from this same markup.
const tableRows = latestRows
  .map((row) =>
    panelRowToTableRow(
      row,
      [...new Set(companiesByCode.get(row.code)?.names.map((entry) => entry.name) ?? [row.name])],
    ),
  )
  .sort((first, second) => first.code.localeCompare(second.code))
const rowsHtml = tableRows.map(tableRowHtml).join('')

const latestTotalHold10k = latestRows.reduce((sum, row) => sum + row.totalHold10k, 0)
const weightedIndividual =
  latestTotalHold10k > 0
    ? latestRows.reduce((sum, row) => sum + row.individualPct * row.totalHold10k, 0) / latestTotalHold10k
    : 0

const pageTitle = `谁在持有上交所的股票：2007–2024 年个股股东结构 | ${SITE_TITLE}`
const description = `上交所《统计年鉴》2008–2025 卷的年末个股股东持股数据：${model.coverage.years} 个年度、${formatCount(
  model.coverage.companies,
)} 只股票、${formatCount(
  model.coverage.rows,
)} 条记录。一页可搜索、可按列排序的表格，点开任意股票看历年股东结构变化，下载原始 CSV。`

const canonical = new URL(localizePath('/shareholders/', 'zh-Hans'), Astro.site)
const home = new URL(localizePath('/', 'zh-Hans'), Astro.site)
const csvURL = new URL(PANEL_CSV_URL, Astro.site)
const jsonURL = new URL(PANEL_JSON_URL, Astro.site)

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: 'zh-Hans',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${home.href}#website`,
        url: home.href,
        name: SITE_TITLE,
        inLanguage: 'zh-Hans',
      },
      about: { '@type': 'Thing', name: '上交所个股股东持股结构' },
      breadcrumb: { '@id': `${canonical.href}#breadcrumb` },
      mainEntity: { '@id': `${canonical.href}#dataset` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: home.href },
        { '@type': 'ListItem', position: 2, name: '持股结构数据表' },
      ],
    },
    {
      '@type': 'Dataset',
      '@id': `${canonical.href}#dataset`,
      name: '上海证券交易所年末个股股东持股结构（2007–2024）',
      description: `上海证券交易所《统计年鉴》2008–2025 卷「年末个股股东持股情况」的结构化数据：${formatCount(
        model.coverage.rows,
      )} 行，一行一只股票一个年末，含自然人、一般法人、专业机构持股数与比例。`,
      url: canonical.href,
      creator: { '@type': 'Organization', name: '上海证券交易所' },
      creditText: '数据整理：surfer（https://github.com/HenryZhang-ZHY/surfer）',
      citation: '上海证券交易所. 上海证券交易所统计年鉴（2008–2025 卷）[M]. 北京: 中国金融出版社.',
      isBasedOn: 'https://github.com/HenryZhang-ZHY/surfer',
      temporalCoverage: '2007/2024',
      spatialCoverage: { '@type': 'Place', name: '中国上海' },
      variableMeasured: ['自然人持股比例', '一般法人持股比例', '专业机构持股比例', '合计持股数'],
      distribution: [
        {
          '@type': 'DataDownload',
          name: 'panel.csv',
          contentUrl: csvURL.href,
          encodingFormat: 'text/csv',
        },
        {
          '@type': 'DataDownload',
          name: 'panel.json',
          contentUrl: jsonURL.href,
          encodingFormat: 'application/json',
        },
      ],
    },
  ],
}
---

<BaseLayout
  title={pageTitle}
  description={description}
  locale={locale}
  path="/shareholders/"
  available={['zh-Hans']}
  sourceLocale="zh-Hans"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <link rel="alternate" type="application/json" title="股东结构数据" href={PANEL_JSON_URL} slot="head" />

  <main class="shell pt-article-top pb-page-bottom" lang="zh-Hans">
    <PageHeader
      class="max-sm:[&>h1]:text-heading-32 [&>p:first-child]:normal-case"
      eyebrow="数据观察 / 股东结构"
      title="谁在持有上交所的股票"
      lede={`2007–2024 年末，上交所每只股票的自然人、一般法人与专业机构持股。表内是逐家公司的比例；按持股数加权，${latestYear} 年末自然人持有全部上交所股票的 ${formatPercent(
        weightedIndividual,
      )}。`}
    >
      <LanguageNote
        slot="note"
        placement="inline"
        locale={locale}
        path="/shareholders/"
        sourceLocale="zh-Hans"
        available={['zh-Hans'] as Locale[]}
      />
      <div slot="meta" class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-line pt-4 font-ui text-label-11 text-ink-tertiary">
        <span>{model.coverage.years} 个年度</span>
        <span>{model.coverage.firstYear}–{model.coverage.lastYear}</span>
        <span class="text-ink">最新 {latestYear} 年末</span>
        <span>{formatCount(latestRows.length)} 只股票</span>
        <span>{formatCount(model.coverage.rows)} 条记录</span>
        <a
          class="ml-auto text-accent underline decoration-accent/40 underline-offset-[0.25em] transition-colors duration-1 hover:decoration-current max-sm:ml-0"
          href={PANEL_CSV_URL}
          download={PANEL_CSV_FILENAME}
        >
          下载原始 CSV ↓
        </a>
      </div>
    </PageHeader>

    <HolderTable years={model.years} latestYear={latestYear} rowCount={latestRows.length} rowsHtml={rowsHtml} />

    <DataNotes model={model} />
  </main>
</BaseLayout>

<script>
  import '../../scripts/shareholder-table'
</script>
