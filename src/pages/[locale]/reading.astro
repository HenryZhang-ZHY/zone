---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../../consts'
import { getCollection } from 'astro:content'
import RunningHead from '@zone/ui/components/RunningHead.astro'
import RecordRow from '@zone/ui/components/RecordRow.astro'
import { localeStaticPaths, t, type Locale } from '../../i18n'
import { linkHost, sourceLabel } from '../../lib/records'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const readingItems = await getCollection('readingList')
const items = readingItems.sort((a, b) => b.data.dateRead.getTime() - a.data.dateRead.getTime())
const isoDate = (date: Date) => date.toISOString().slice(0, 10)
---

<BaseLayout
  locale={locale}
  path="/reading/"
  title={`${i18n.readingTitle} | ${SITE_TITLE}`}
  description={i18n.readingDescription}
>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-measure">
      <RunningHead label={i18n.reading} count={i18n.readingCount(items.length)} />

      {
        items.length > 0 ? (
          <ul class="m-0 list-none p-0">
            {items.map((item) => (
              <RecordRow
                lead={isoDate(item.data.dateRead)}
                datetime={isoDate(item.data.dateRead)}
                title={item.data.title}
                href={item.data.ogUrl}
                source={sourceLabel(linkHost(item.data.ogUrl))}
              />
            ))}
          </ul>
        ) : (
          <div class="py-16 text-center font-ui text-copy-14 text-ink-tertiary">
            <h2 class="font-prose text-heading-24 text-ink">{i18n.noReading}</h2>
            <p class="mt-2">{i18n.noReadingHint}</p>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
