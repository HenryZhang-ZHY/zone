---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Entry from '@zone/ui/components/Entry.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import { formatDate, localeTags, segmentOf, t, type Locale } from '../../../i18n'
import { localizeSeries } from '../../../lib/localized'
import { loadPosts } from '../../../lib/posts'
import { getSeriesPosts } from '../../../lib/series'

export async function getStaticPaths() {
  const allSeries = await getCollection('series')
  return localeTags.flatMap((locale) =>
    allSeries.map((series) => ({ params: { locale: segmentOf(locale), id: series.id }, props: { locale, series } })),
  )
}

type Props = { locale: Locale; series: CollectionEntry<'series'> }

const { locale, series } = Astro.props
const { posts, localize } = await loadPosts()
const entries = getSeriesPosts(posts, series.id).map((post) => localize(post, locale))
const { title, description, lang } = localizeSeries(series, locale)
const available = localeTags.filter((tag) => tag === series.data.lang || series.data.translations?.[tag])
---

<BaseLayout locale={locale} path={`/series/${series.id}/`} title={title} description={description} available={available} sourceLocale={series.data.lang} editorial>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-reading">
      <div lang={lang}>
        <PageHeader title={title} lede={description} class="mb-10" />
      </div>
      <ol class="m-0 list-none p-0">
        {entries.map((entry) => (
          <Entry
            date={t(entry.contentLang).seriesPart(entry.post.data.seriesOrder!)}
            datetime={entry.post.data.pubDate.toISOString()}
            title={entry.title}
            excerpt={entry.description}
            href={entry.href}
            lang={entry.contentLang}
            meta={[formatDate(entry.post.data.pubDate, locale)]}
          />
        ))}
      </ol>
    </div>
  </main>
</BaseLayout>
