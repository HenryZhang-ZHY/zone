---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '@zone/ui/components/Entry.astro'
import { endonym, localeStaticPaths, t, type Locale } from '../../i18n'
import { localizeSeries } from '../../lib/localized'
import { loadPosts, type LocalizedPost } from '../../lib/posts'

export const getStaticPaths = localeStaticPaths

const { locale } = Astro.props as { locale: Locale }
const i18n = t(locale)
const { posts, localize } = await loadPosts()
const entries = posts.map((post) => localize(post, locale))
const allSeries = new Map((await getCollection('series')).map((s) => [s.id, s]))
const seriesLabel = ({ post, contentLang }: LocalizedPost) => {
  const series = post.data.series && allSeries.get(post.data.series.id)
  if (!series) return undefined
  return `${localizeSeries(series, contentLang).title} · ${t(contentLang).seriesPart(post.data.seriesOrder!)}`
}
const isoDate = (date: Date) => date.toISOString().slice(0, 10)
---

<BaseLayout locale={locale} path="/" xDefault="/" editorial>
  <main class="shell py-page-top pb-page-bottom">
    <div class="mx-auto max-w-reading">
      <h1 class="sr-only">{i18n.writing}</h1>
      {
        entries.length > 0 ? (
          <ul class="m-0 list-none p-0">
            {entries.map((entry) => (
              <Entry
                date={isoDate(entry.post.data.pubDate)}
                datetime={entry.post.data.pubDate.toISOString()}
                title={entry.title}
                excerpt={entry.description}
                href={entry.href}
                lang={entry.contentLang}
                meta={[
                  seriesLabel(entry),
                  entry.isFallback ? endonym(entry.contentLang) : undefined,
                ].filter((item): item is string => Boolean(item))}
              />
            ))}
          </ul>
        ) : (
          <div class="py-24 text-center font-ui text-copy-14 text-ink-tertiary">
            <h2 class="font-prose text-heading-24 text-ink">{i18n.noPosts}</h2>
            <p class="mt-2">{i18n.noPostsHint}</p>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
