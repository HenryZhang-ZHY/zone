---
import {
  tableHeadHtml,
  tableLoadingRowHtml,
  tableRowHtml,
  type ColumnDef,
  type MarketInfo,
  type TableRow,
} from '../../lib/shareholders/table'
import { formatCount } from '../../lib/shareholders/view'

interface Props {
  markets: MarketInfo[]
  defaultMarket: MarketInfo
  defaultColumns: readonly ColumnDef[]
  previewRows: TableRow[]
  previewLabel: string
}

const { markets, defaultMarket, defaultColumns, previewRows, previewLabel } = Astro.props
const yearsDescending = [...defaultMarket.years].sort((a, b) => b - a)
---

<section
  class="holder"
  data-holder-table
  data-markets={JSON.stringify(markets)}
  data-default-market={defaultMarket.id}
  data-default-year={defaultMarket.latestYear}
  aria-labelledby="holder-heading"
>
  <h2 id="holder-heading" class="sr-only">沪深个股股东结构表</h2>

  <div class="holder-markets" role="group" aria-label="选择交易所">
    {markets.map((market) => (
      <button
        type="button"
        class="holder-market"
        data-market={market.id}
        aria-pressed={market.id === defaultMarket.id ? 'true' : 'false'}
      >
        <span class="holder-market__label">{market.label}</span>
        <span class="holder-market__metric">{market.metric}</span>
        <span class="holder-market__range">{market.years[0]}–{market.years.at(-1)}</span>
      </button>
    ))}
  </div>

  <div class="holder-toolbar">
    <div class="holder-search">
      <label class="holder-search__label" for="holder-search">搜索</label>
      <input
        id="holder-search"
        class="holder-search__input"
        type="search"
        placeholder="代码、简称或板块"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-label="搜索股票代码、简称或板块"
      />
    </div>

    <div class="holder-year">
      <label class="holder-year__label" for="holder-year">年份</label>
      <select id="holder-year" class="holder-year__select" data-holder-year>
        {yearsDescending.map((year) => (
          <option value={year} selected={year === defaultMarket.latestYear}>{year}</option>
        ))}
      </select>
    </div>

    <p class="holder-count" role="status" aria-live="polite">
      <span data-holder-count>{formatCount(defaultMarket.latestCount)}</span> 只
    </p>
  </div>

  <div class="holder-viewport" data-holder-viewport role="region" aria-label="个股股东结构表，可滚动" tabindex="0">
    <table class="holder-table">
      <caption class="sr-only" data-holder-caption>
        沪深个股股东结构表。上交所按自然人、一般法人、专业机构拆分；深交所按持股规模拆分。各列可按升序或降序排列，每只股票可展开历年变化。
      </caption>
      <thead data-holder-head set:html={tableHeadHtml(defaultColumns)} />
      <tbody data-holder-body set:html={tableLoadingRowHtml(defaultColumns.length)} />
    </table>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-holder-status></p>

  <noscript>
    <style is:inline>
      .holder-markets,
      .holder-toolbar,
      .holder-viewport {
        display: none !important;
      }
    </style>
    <p class="holder-noscript">
      交互表需要 JavaScript；下面是{previewLabel}前 20 行预览。完整数据可直接下载：
      {markets.map((market, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={market.csvUrl} download={market.csvFilename}>{market.label} CSV</a>
        </>
      ))}
    </p>
    <div class="holder-preview-wrap" role="region" aria-label="上交所最新年末前 20 行预览，可左右滚动" tabindex="0">
      <table class="holder-table holder-table--preview">
        <caption class="sr-only">{previewLabel}前 20 行预览</caption>
        <thead set:html={tableHeadHtml(defaultColumns, 'code', 'asc', false)} />
        <tbody set:html={previewRows.map((row) => tableRowHtml(row, defaultColumns, false)).join('')} />
      </table>
    </div>
  </noscript>
</section>
