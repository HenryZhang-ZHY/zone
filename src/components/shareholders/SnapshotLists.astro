---
import { formatCount, formatPercent } from '../../lib/shareholders/view'

export interface SnapshotRow {
  code: number
  name: string
  codeText: string
  board: string
  value: string
  sub?: string
}

interface Props {
  latestYear: number
  topIndividual: SnapshotRow[]
  bottomIndividual: SnapshotRow[]
  topInstitution: SnapshotRow[]
  moversUp: SnapshotRow[]
  moversDown: SnapshotRow[]
  aShareCount: number
  bShareCount: number
  bShareMedian: number
}

const {
  latestYear,
  topIndividual,
  bottomIndividual,
  topInstitution,
  moversUp,
  moversDown,
  aShareCount,
  bShareCount,
  bShareMedian,
} = Astro.props

const blocks = [
  { title: '自然人持股最高', count: `A 股 ${formatCount(aShareCount)} 只`, rows: topIndividual },
  { title: '自然人持股最低', count: `A 股 ${formatCount(aShareCount)} 只`, rows: bottomIndividual },
  { title: '专业机构持股最高', count: `A 股 ${formatCount(aShareCount)} 只`, rows: topInstitution },
]
---

<div class="snapshot-grid">
  {blocks.map((block) => (
    <section>
      <header class="snapshot-block__head">
        <h3 class="snapshot-block__title">{block.title}</h3>
        <span class="snapshot-block__count">{block.count}</span>
      </header>
      <ol class="snapshot-list">
        {block.rows.map((row, index) => (
          <li>
            <a class="snapshot-row" href={`?stock=${row.codeText}#stock`}>
              <span class="snapshot-row__rank">{String(index + 1).padStart(2, '0')}</span>
              <span class="snapshot-row__body">
                <span class="snapshot-row__name">{row.name}</span>
                <span class="snapshot-row__code">{row.codeText}</span>
                <span class="snapshot-row__meta">{row.board}</span>
              </span>
              <span class="snapshot-row__value">{row.value}{row.sub && <span>{row.sub}</span>}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section>
    <header class="snapshot-block__head">
      <h3 class="snapshot-block__title">一年内变化最大</h3>
      <span class="snapshot-block__count">2023 → {latestYear}</span>
    </header>
    <p class="mt-2 font-ui text-label-11 leading-[1.7] text-ink-tertiary">同口径年度比较；仅列两年都被年鉴收录的 A 股。</p>
    {[
      { label: '上升', rows: moversUp },
      { label: '下降', rows: moversDown },
    ].map((group) => (
      <div>
        <p class="mt-4 font-ui text-label-11 text-ink-quiet">{group.label}</p>
        <ol class="snapshot-list">
          {group.rows.map((row, index) => (
            <li>
              <a class="snapshot-row" href={`?stock=${row.codeText}#stock`}>
                <span class="snapshot-row__rank">{String(index + 1).padStart(2, '0')}</span>
                <span class="snapshot-row__body">
                  <span class="snapshot-row__name">{row.name}</span>
                  <span class="snapshot-row__code">{row.codeText}</span>
                  <span class="snapshot-row__meta">{row.board}</span>
                </span>
                <span class="snapshot-row__value">{row.value}{row.sub && <span>{row.sub}</span>}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</div>

<p class="snapshot-note">
  A 股榜单不含 {bShareCount} 只 B 股；B 股 2024 年末自然人持股中位数为 {formatPercent(bShareMedian)}。点击股票名，在上方「个股查询」中查看它的完整历史。
</p>
