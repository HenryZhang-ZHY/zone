---
import { BOARD_OPTIONS, type BoardKey, type CompactStats, type MarketSeries } from '../../lib/shareholders/types'
import {
  annualTableRows,
  marketChartGeometry,
  marketChartLabel,
  marketSummary,
  yearX,
} from '../../lib/shareholders/view'

interface Props {
  years: number[]
  stats: Record<BoardKey, MarketSeries>
  compact: CompactStats
  latestYear: number
}

const { years, stats, compact, latestYear } = Astro.props
const all = stats.all
const geometry = marketChartGeometry(all)
const axisValues = [100, 75, 50, 25, 0]
const markers = [
  { year: 2009, label: '2009 合计口径', key: '2009', hidden: false },
  { year: 2013, label: '2013 B 股记录异常', key: 'degenerate', hidden: true },
  { year: 2022, label: '2022 分类调整', key: '2022', hidden: false },
].map((marker) => ({ ...marker, x: yearX(years.indexOf(marker.year), years.length) }))
const rows = annualTableRows(years, all, latestYear)
---

<div data-market-chart data-latest-year={latestYear}>
  <script type="application/json" data-market-stats set:html={JSON.stringify(compact)} />

  <fieldset class="market__boards">
    <legend class="sr-only">选择板块</legend>
    {BOARD_OPTIONS.map((option) => (
      <label class="market__board">
        <input type="radio" name="market-board" value={option.key} checked={option.key === 'all'} />
        <span>{option.label}</span>
      </label>
    ))}
  </fieldset>

  <figure class="market__figure">
    <div class="market__frame">
      <div class="market__axis-y" aria-hidden="true">
        {axisValues.map((value) => (
          <span style={`top: ${100 - value}%`}>{value}%</span>
        ))}
      </div>
      <div class="market__plot" data-market-plot>
        <svg
          class="market__svg"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          role="img"
          aria-label={marketChartLabel(all, '全部')}
          data-market-svg
        >
          {axisValues.map((value) => (
            <line class="market__grid" x1="0" x2="100" y1={100 - value} y2={100 - value} />
          ))}
          {markers.map((marker) => (
            <line
              class="market__marker"
              data-market-marker={marker.key}
              x1={marker.x}
              x2={marker.x}
              y1="0"
              y2="100"
              data-hidden={marker.hidden ? 'true' : undefined}
            />
          ))}
          <path class="market__band" d={geometry.band} data-market-band />
          <path class="market__median" d={geometry.median} data-market-median />
          <path class="market__weighted" d={geometry.weighted} data-market-weighted />
        </svg>

        {markers.map((marker) => (
          <span
            class="market__marker-label"
            data-market-marker-label={marker.key}
            style={`left: ${marker.x}%`}
            aria-hidden="true"
            data-hidden={marker.hidden ? 'true' : undefined}
          >
            {marker.label}
          </span>
        ))}

        <span class="market__crosshair" data-market-crosshair hidden></span>
        <span class="market__dot market__dot--median" data-market-dot="median" hidden></span>
        <span class="market__dot market__dot--weighted" data-market-dot="weighted" hidden></span>
      </div>
    </div>

    <div class="market__axis-x" style={`--market-years: ${years.length}`} aria-hidden="true">
      {years.map((year) => <span>{year}</span>)}
    </div>

    <figcaption>
      <div class="market__legend" aria-hidden="true">
        <span class="market__legend-item"><span class="market__legend-band"></span>P25–P75（公司区间）</span>
        <span class="market__legend-item"><span class="market__legend-line market__legend-line--median"></span>自然人中位（公司）</span>
        <span class="market__legend-item"><span class="market__legend-line market__legend-line--weighted"></span>自然人加权（持股数）</span>
      </div>
      <p class="market__readout" data-market-readout>{marketSummary(all, '全部')}</p>
      <p class="sr-only" role="status" aria-live="polite" data-market-live></p>
      <p class="mt-2 font-ui text-label-11 leading-[1.7] text-ink-tertiary">
        悬停折线可查看各年数值。2007–2008 年末的合计为流通股口径，2009 年起为 A 股总股本；2022 年起股东分类调整。两处断点在图中以竖线标出。B
        股只收录 2013、2022–2024 年末，其中 2013 年末的 53 条记录全部记为自然人 100%，疑为原始表退化，不作分布解读。读跨年结论时请先看
        <a class="text-accent underline decoration-accent/40 underline-offset-[0.25em] hover:decoration-current" href="#method">数据说明</a>。
      </p>
    </figcaption>
  </figure>

  <div
    class="panel-table-wrap mt-10"
    role="region"
    aria-label="历年股东结构数据表，可左右滚动"
    tabindex="0"
  >
    <table class="panel-table">
      <caption class="sr-only">
        各年末自然人持股比例：按持股数加权、公司中位数与四分位区间，以及自然人持股超过 50% 的公司占比。
      </caption>
      <thead>
        <tr>
          <th scope="col">年末</th>
          <th scope="col">公司数</th>
          <th scope="col">自然人·加权</th>
          <th scope="col">自然人·中位</th>
          <th scope="col">P25–P75</th>
          <th scope="col">自然人&gt;50%</th>
          <th scope="col">一般法人·加权</th>
          <th scope="col">专业机构·加权</th>
        </tr>
      </thead>
      <tbody data-market-table-body set:html={rows} />
    </table>
  </div>
  <p class="panel-scroll-hint mt-3 font-ui text-label-11 text-ink-tertiary">表格可左右滑动，查看全部列。</p>
</div>
