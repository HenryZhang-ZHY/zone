---
import { LOCALE_COOKIE, localeTags, localizePath, t, type Locale } from '../i18n'
import { rankLocales, suggestLocale } from '../i18n/match'
import { mountLanguageSuggestion, type SuggestionConfig } from '../scripts/language-suggestion'

interface Props {
	locale: Locale
	path: string
	/** Languages the page really exists in. */
	available: Locale[]
	mode: SuggestionConfig['mode']
}

const { locale, path, available, mode } = Astro.props

const config: SuggestionConfig = {
	current: locale,
	available,
	supported: localeTags,
	cookie: LOCALE_COOKIE,
	storageKey: 'zone:language-suggestion',
	mode,
	links: Object.fromEntries(
		available
			.filter((tag) => tag !== locale)
			.map((tag) => [tag, { href: localizePath(path, tag), text: t(tag).suggestLanguage, action: t(tag).switchLanguage, dismiss: t(tag).dismiss }]),
	),
}

// The matching logic is the tested TypeScript in src/i18n/match.ts, serialized so it
// can run synchronously where the suggestion is shown.
const code = `(() => {
${rankLocales}
${suggestLocale}
(${mountLanguageSuggestion})(${JSON.stringify(config).replace(/</g, '\\u003c')}, suggestLocale)
})()`
---

{Object.keys(config.links).length > 0 && <script is:inline set:html={code} />}
