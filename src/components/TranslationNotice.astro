---
import LanguageSuggestion from './LanguageSuggestion.astro'
import { endonym, localizePath, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
  path: string
  sourceLocale: Locale
  available: Locale[]
  outdated: boolean
}

const { locale, path, sourceLocale, available, outdated } = Astro.props
const i18n = t(locale)
const isFallback = !available.includes(locale)
const others = available.filter((tag) => tag !== locale)
const sourceName = endonym(sourceLocale)
---

<aside class="shell pt-4">
  <div class="mx-auto max-w-reading">
    <div class="border-l-2 border-line-strong bg-surface px-4 py-3 font-ui text-copy-13 text-ink-secondary">
    <div class="space-y-1">
      {isFallback ? (
        <p>
          {i18n.untranslated(sourceName)}{' '}
          <a
            class="text-accent underline decoration-accent/40 underline-offset-[0.25em] hover:decoration-current"
            href={localizePath(path, sourceLocale)}
            hreflang={sourceLocale}
          >
            {i18n.readOriginal}
          </a>
        </p>
      ) : (
        <p>
          {i18n.translatedFrom(sourceName)}{' '}
          <a
            class="text-accent underline decoration-accent/40 underline-offset-[0.25em] hover:decoration-current"
            href={localizePath(path, sourceLocale)}
            hreflang={sourceLocale}
          >
            {i18n.readOriginal}
          </a>
        </p>
      )}
      {outdated && <p>{i18n.outdatedTranslation}</p>}
      {isFallback && others.length > 1 && (
        <p>
          {i18n.alsoAvailableIn}{' '}
          <span class="inline-flex flex-wrap gap-x-3 gap-y-1">
            {others.map((tag) => (
              <span data-version={tag}>
                <a
                  class="text-accent underline decoration-accent/40 underline-offset-[0.25em] hover:decoration-current"
                  href={localizePath(path, tag)}
                  hreflang={tag}
                  lang={tag}
                  data-locale={tag}
                >
                  {endonym(tag)}
                </a>
              </span>
            ))}
          </span>
        </p>
      )}
      <LanguageSuggestion locale={locale} path={path} available={available} mode="notice" />
    </div>
  </div>
  </div>
</aside>
