---
import { endonym, languageName, localizePath, t, type Locale } from '../i18n'

interface Props {
	locale: Locale
	path: string
	sourceLocale: Locale
	available: Locale[]
	outdated: boolean
}

const { locale, path, sourceLocale, available, outdated } = Astro.props
const i18n = t(locale)
const source = languageName(sourceLocale, locale)
const isFallback = !available.includes(locale)
const others = available.filter((tag) => tag !== locale)
---

<aside class="translation-notice-shell">
	<div class="translation-notice">
		{isFallback ? (
			<p>{i18n.untranslated(source)}</p>
		) : (
			<p>
				{i18n.translatedFrom(source)}{' '}
				<a href={localizePath(path, sourceLocale)} hreflang={sourceLocale}>{i18n.readOriginal}</a>
			</p>
		)}
		{outdated && <p>{i18n.outdatedTranslation}</p>}
		{isFallback && others.length > 1 && (
			<p>
				{i18n.alsoAvailableIn}{' '}
				{others.map((tag, index) => (
					<>
						{index > 0 && ' · '}
						<a href={localizePath(path, tag)} hreflang={tag} lang={tag}>{endonym(tag)}</a>
					</>
				))}
			</p>
		)}
	</div>
</aside>

<style>
	.translation-notice-shell {
		width: min(100%, var(--z-page-max-width));
		margin: var(--z-space-6) auto 0;
		padding: 0 var(--z-page-pad-x);
	}

	:global(.z-page-shell--editorial) .translation-notice {
		max-width: var(--z-article-reading-width);
		margin-inline: auto;
	}

	.translation-notice {
		display: grid;
		gap: var(--z-space-1);
		padding: var(--z-space-3) var(--z-space-4);
		border-inline-start: 2px solid var(--z-color-border);
		background: var(--z-color-row-hover);
		color: var(--z-color-text-secondary);
	}

	/* Text size is set on the lines, not the box, so the box's ch-based width matches the article column. */
	.translation-notice p {
		font-size: var(--z-text-copy-13);
		line-height: var(--z-leading-copy-13);
	}

	.translation-notice a {
		color: var(--z-color-text-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
