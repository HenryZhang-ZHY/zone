---
import LanguageSuggestion from './LanguageSuggestion.astro'
import { endonym, languageName, localizePath, t, type Locale } from '../i18n'

interface Props {
	locale: Locale
	path: string
	sourceLocale: Locale
	available: Locale[]
	outdated: boolean
}

const { locale, path, sourceLocale, available, outdated } = Astro.props
const i18n = t(locale)
const source = languageName(sourceLocale, locale)
const isFallback = !available.includes(locale)
const others = available.filter((tag) => tag !== locale)
---

<aside class="z-notice-shell">
	<div class="z-notice">
		{isFallback ? (
			<p>{i18n.untranslated(source)}</p>
		) : (
			<p>
				{i18n.translatedFrom(source)}{' '}
				<a href={localizePath(path, sourceLocale)} hreflang={sourceLocale}>{i18n.readOriginal}</a>
			</p>
		)}
		{outdated && <p>{i18n.outdatedTranslation}</p>}
		{isFallback && others.length > 1 && (
			<p>
				{i18n.alsoAvailableIn}{' '}
				<span class="z-notice-versions">
					{others.map((tag) => (
						<span data-version={tag}><a href={localizePath(path, tag)} hreflang={tag} lang={tag}>{endonym(tag)}</a></span>
					))}
				</span>
			</p>
		)}
		<LanguageSuggestion locale={locale} path={path} available={available} mode="notice" />
	</div>
</aside>
