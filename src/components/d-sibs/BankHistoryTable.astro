---
import {
  type BankHistory,
  groupKeys,
  groupLabels,
  typeLabel,
} from '../../lib/d-sibs'
import GroupMark from '@zone/ui/components/GroupMark.astro'
import BankSparkline from './BankSparkline.astro'

interface Props {
  years: string[]
  banks: BankHistory[]
}

const { years, banks } = Astro.props
const presentGroups = groupKeys.filter((group) =>
  banks.some((bank) => Object.values(bank.years).some((info) => info?.group === group)),
)
---

<div class="mb-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 font-ui text-label-11 text-ink-tertiary">
  {presentGroups.map((group) => (
    <GroupMark group={group} label={groupLabels[group]} srLabel={groupLabels[group]} />
  ))}
</div>

<div
  class="overflow-x-auto border-y border-line-strong focus-visible:focus-ring"
  role="region"
  aria-label="银行历年分组明细，可横向滚动"
  tabindex="0"
>
  <table class="w-full min-w-[44rem] border-collapse text-left">
    <caption class="sr-only">各银行在已收录公告年份的入选组别；破折号表示该年未入选</caption>
    <thead>
      <tr class="border-b border-line-strong bg-canvas font-ui text-label-11 text-ink-tertiary">
        <th scope="col" class="sticky left-0 z-20 min-w-[9rem] bg-canvas px-3 py-2.5 text-left font-medium">银行</th>
        <th scope="col" class="whitespace-nowrap px-3 py-2.5 text-left font-medium">类型</th>
        {years.map((year, index) => (
          <th
            scope="col"
            class:list={[
              'min-w-[4.5rem] px-3 py-2.5 text-center font-medium tabular-nums',
              index === years.length - 1 && 'text-ink',
            ]}
          >
            {year}
            {index === years.length - 1 && <span class="ml-1 inline-block size-1 bg-accent align-middle" aria-hidden="true"></span>}
          </th>
        ))}
        <th scope="col" class="min-w-[5.5rem] px-3 py-2.5 text-center font-medium">轨迹</th>
      </tr>
    </thead>
    <tbody>
      {banks.map((bank) => (
        <tr class="group border-b border-line last:border-b-0 hover:bg-surface" data-bank={bank.name}>
          <th
            scope="row"
            class="sticky left-0 z-10 min-w-[9rem] bg-canvas px-3 py-3 text-left font-prose text-copy-14 font-medium text-ink group-hover:bg-surface"
          >
            {bank.name}
          </th>
          <td class="whitespace-nowrap px-3 py-3 font-ui text-label-11 text-ink-tertiary">
            {bank.latestType ? typeLabel(bank.latestType) : '—'}
          </td>
          {years.map((year) => {
            const info = bank.years[year]
            return (
              <td class="px-3 py-3 text-center">
                {info ? (
                  <GroupMark group={info.group} label={String(info.group)} srLabel={groupLabels[info.group]} class="justify-center" />
                ) : (
                  <span class="font-ui text-label-13 text-ink-quiet" aria-label="未入选">—</span>
                )}
              </td>
            )
          })}
          <td class="px-2 py-2 text-center">
            <button
              type="button"
              class="spark-trigger inline-flex min-h-9 min-w-[4.5rem] items-center justify-center border border-transparent px-1 text-ink-tertiary transition-[color,background-color,border-color] duration-1 ease-out hover:border-line hover:bg-canvas hover:text-ink focus-visible:focus-ring active:bg-surface-strong aria-expanded:border-line-strong aria-expanded:bg-canvas aria-expanded:text-ink"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="spark-popover"
              aria-label={`${bank.name} 变迁详情`}
              data-bank-name={bank.name}
              data-trajectory={JSON.stringify(
                years.map((year) => {
                  const info = bank.years[year]
                  return info ? { year, group: info.group, type: info.type } : { year, group: null, type: null }
                }),
              )}
            >
              <BankSparkline years={years} history={bank.years} />
            </button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
