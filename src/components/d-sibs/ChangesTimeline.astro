---
import { type YearChange, groupLabels } from '../../lib/d-sibs'
import GroupMark from '@zone/ui/components/GroupMark.astro'

interface Props {
  changes: YearChange[]
}

const { changes } = Astro.props

function changeCount(change: YearChange): number {
  return change.entered.length + change.exited.length + change.upgraded.length + change.downgraded.length
}

function spanLabel(change: YearChange): string {
  const span = Number(change.to) - Number(change.from)
  if (!Number.isFinite(span) || span <= 1) return ''

  return `相隔 ${span} 年发布`
}

function summary(change: YearChange): string {
  const parts = [
    change.entered.length > 0 ? `新增 ${change.entered.length} 家` : '',
    change.exited.length > 0 ? `退出 ${change.exited.length} 家` : '无退出',
    change.upgraded.length > 0 ? `上升 ${change.upgraded.length} 家` : '',
    change.downgraded.length > 0 ? `下降 ${change.downgraded.length} 家` : '',
  ].filter(Boolean)

  return parts.length > 0 ? parts.join('，') : '无名单变化'
}

const orderedChanges = [...changes].reverse()
---

<div class="relative">
  <div class="absolute inset-y-0 left-0 w-px bg-line" aria-hidden="true"></div>
  {
    orderedChanges.map((change) => {
      const total = changeCount(change)
      const hasChanges = total > 0
      const span = spanLabel(change)

      return (
        <article class="relative border-b border-line py-6 pl-5 last:border-b-0 sm:pl-6">
          <span
            class="absolute left-0 top-8 size-1.5 -translate-x-1/2 bg-canvas ring-1 ring-line-strong"
            aria-hidden="true"
          />

          <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <div>
              <h3 class="font-prose text-heading-20 text-ink">
                {change.from} → {change.to}
              </h3>
              {span && <p class="mt-1 font-ui text-label-11 text-ink-tertiary">{span}</p>}
            </div>
            <p class="font-ui text-label-11 tabular-nums text-ink-tertiary">
              {hasChanges ? `${total} 项变化` : '无变化'}
            </p>
          </header>

          <p class={`mt-2 max-w-[62ch] font-ui text-copy-13 leading-[1.6] ${hasChanges ? 'text-ink-secondary' : 'text-ink-tertiary'}`}>
            {summary(change)}
          </p>

          {hasChanges && (
            <div class="mt-5 grid gap-x-8 gap-y-5 sm:grid-cols-2">
              {change.entered.length > 0 && (
                <div class="border-t border-line pt-3">
                  <div class="flex items-baseline gap-2 font-ui text-label-11">
                    <span class="text-ink-quiet" aria-hidden="true">＋</span>
                    <span class="text-ink">新增入选</span>
                    <span class="ml-auto tabular-nums text-ink-tertiary">{change.entered.length}</span>
                  </div>
                  <div class="mt-2 grid gap-1.5">
                    {change.entered.map(([name, group]) => (
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-prose text-copy-13 text-ink">{name}</span>
                        <GroupMark group={group} label={groupLabels[group]} srLabel={groupLabels[group]} />
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {change.exited.length > 0 && (
                <div class="border-t border-line pt-3">
                  <div class="flex items-baseline gap-2 font-ui text-label-11">
                    <span class="text-ink-quiet" aria-hidden="true">−</span>
                    <span class="text-ink">退出名单</span>
                    <span class="ml-auto tabular-nums text-ink-tertiary">{change.exited.length}</span>
                  </div>
                  <div class="mt-2 grid gap-1.5">
                    {change.exited.map((name) => (
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-prose text-copy-13 text-ink">{name}</span>
                        <span class="font-ui text-label-11 text-ink-tertiary">退出</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {change.upgraded.length > 0 && (
                <div class="border-t border-line pt-3">
                  <div class="flex items-baseline gap-2 font-ui text-label-11">
                    <span class="text-ink-quiet" aria-hidden="true">↑</span>
                    <span class="text-ink">组别上升</span>
                    <span class="ml-auto tabular-nums text-ink-tertiary">{change.upgraded.length}</span>
                  </div>
                  <div class="mt-2 grid gap-1.5">
                    {change.upgraded.map(([name, from, to]) => (
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-prose text-copy-13 text-ink">{name}</span>
                        <span class="inline-flex items-baseline gap-1.5">
                          <GroupMark group={from} label={String(from)} srLabel={groupLabels[from]} />
                          <span class="font-ui text-label-11 text-ink-quiet" aria-hidden="true">→</span>
                          <GroupMark group={to} label={String(to)} srLabel={groupLabels[to]} />
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {change.downgraded.length > 0 && (
                <div class="border-t border-line pt-3">
                  <div class="flex items-baseline gap-2 font-ui text-label-11">
                    <span class="text-ink-quiet" aria-hidden="true">↓</span>
                    <span class="text-ink">组别下降</span>
                    <span class="ml-auto tabular-nums text-ink-tertiary">{change.downgraded.length}</span>
                  </div>
                  <div class="mt-2 grid gap-1.5">
                    {change.downgraded.map(([name, from, to]) => (
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-prose text-copy-13 text-ink">{name}</span>
                        <span class="inline-flex items-baseline gap-1.5">
                          <GroupMark group={from} label={String(from)} srLabel={groupLabels[from]} />
                          <span class="font-ui text-label-11 text-ink-quiet" aria-hidden="true">→</span>
                          <GroupMark group={to} label={String(to)} srLabel={groupLabels[to]} />
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
        </article>
      )
    })
  }
</div>
