---
import { type YearStats, groupKeys, groupLabels } from '../../lib/d-sibs'
import GroupMark from '@zone/ui/components/GroupMark.astro'

interface Props {
  yearStats: YearStats[]
}

const { yearStats } = Astro.props
const groupOrder = [...groupKeys].reverse()
---

<div class="grid gap-x-10 gap-y-12 md:grid-cols-2">
  {
    [...yearStats].reverse().map((stats, index) => {
      const groups = groupOrder.filter((group) => stats.groups[group].length > 0)

      return (
        <section
          class:list={[
            'min-w-0 border-t-2 pt-4',
            index === 0 ? 'border-accent' : 'border-line-strong',
          ]}
          aria-labelledby={`archive-${stats.year}`}
        >
          <header class="flex items-baseline justify-between gap-4">
            <h3 id={`archive-${stats.year}`} class="font-prose text-heading-24 text-ink">
              <a
                class="underline decoration-transparent underline-offset-[0.2em] transition-[color,text-decoration-color] duration-1 hover:text-accent hover:decoration-current"
                href={stats.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {stats.year} ↗
              </a>
            </h3>
            <p class="font-ui text-label-11 tabular-nums text-ink-tertiary">
              {index === 0 && <span class="mr-2 text-ink">最新</span>}
              {stats.total} 家
            </p>
          </header>

          <div class="mt-5 grid gap-4">
            {groups.map((group) => (
              <div>
                <div class="flex items-baseline gap-3 border-b border-line pb-1.5 font-ui text-label-11">
                  <GroupMark group={group} label={groupLabels[group]} srLabel={groupLabels[group]} />
                  <span class="ml-auto tabular-nums text-ink-tertiary">{stats.groups[group].length}</span>
                </div>
                <ul class="mt-2 flex flex-wrap gap-x-1 gap-y-1 p-0 font-prose text-copy-14 leading-[1.7] text-ink-secondary">
                  {stats.groups[group].map((entry, entryIndex) => (
                    <li class="m-0 list-none">
                      {entry.name}
                      {entryIndex < stats.groups[group].length - 1 && (
                        <span class="mx-1.5 text-ink-quiet" aria-hidden="true">·</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    })
  }
</div>
