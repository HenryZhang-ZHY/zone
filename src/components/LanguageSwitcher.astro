---
import { LOCALE_COOKIE, locales, localizePath, type Locale } from '../i18n'

interface Props {
	/** The current language, if the page has one. */
	locale?: Locale
	/** Site path to link in every language. */
	path: string
	label: string
}

const { locale, path, label } = Astro.props
---

<nav class="language-switcher" aria-label={label}>
	<ul class="language-list">
		{locales.map(({ tag, name }) => (
			<li>
				<a href={localizePath(path, tag)} hreflang={tag} lang={tag} aria-current={tag === locale ? 'true' : undefined} data-locale={tag}>{name}</a>
			</li>
		))}
	</ul>
</nav>

<script define:vars={{ cookie: LOCALE_COOKIE }}>
	// Remember the choice so the root URL can send this reader to it next time.
	document.addEventListener('click', (event) => {
		const link = event.target instanceof Element && event.target.closest('a[data-locale]')
		if (link) document.cookie = `${cookie}=${link.dataset.locale}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`
	})
</script>

<style>
	.language-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		column-gap: var(--z-space-3);
		row-gap: var(--z-space-1);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.language-list li + li::before {
		content: "·";
		margin-right: var(--z-space-3);
		color: var(--z-color-text-dimmed);
	}

	.language-list a {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		color: var(--z-color-text-dimmed);
		font-size: var(--z-text-label-13);
		line-height: var(--z-leading-label-13);
		transition: color 150ms ease;
	}

	.language-list a:hover {
		color: var(--z-color-text-accent);
		text-decoration: underline;
	}

	.language-list a[aria-current] {
		color: var(--z-color-heading);
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.language-list a {
			min-height: 44px;
		}
	}
</style>
