---
import BaseHead from '../components/BaseHead.astro'
import LanguageIndex from '../components/LanguageIndex.astro'
import SiteFooter from '@zone/ui/components/SiteFooter.astro'
import SiteHeader from '@zone/ui/components/SiteHeader.astro'
import LanguageMenu from '@zone/ui/components/LanguageMenu.astro'
import { LOCALE_COOKIE, endonym, localeTags, localizePath, t, type Locale } from '../i18n'
import { alternateLinks } from '../lib/localized'
import { SITE_TITLE } from '../consts'

interface Props {
  /** Language of the page chrome, from the URL. */
  locale: Locale
  /** Site path without the locale segment, e.g. `/blog/refuge/`. */
  path: string
  title?: string
  description?: string
  image?: string
  /** Languages the page's main content exists in. Pages built only from UI strings exist in all. */
  available?: Locale[]
  /** Language the main content was written in; the canonical URL when this locale has no version. */
  sourceLocale?: Locale
  /** hreflang x-default: a locale's version of this page, or another URL such as `/`. */
  xDefault?: Locale | string
  /** Retained for page compatibility; the migrated layout uses the design system's measures. */
  pageLayout?: 'narrow' | 'medium' | 'wide' | 'article'
  editorial?: boolean
}

const {
  locale,
  path,
  title,
  description,
  image = '/open-graph-image.webp',
  available = localeTags,
  sourceLocale = 'en',
  xDefault = sourceLocale,
} = Astro.props

const isFallback = !available.includes(locale)
const canonicalURL = new URL(localizePath(path, isFallback ? sourceLocale : locale), Astro.site)
const alternates = alternateLinks(path, available, xDefault, Astro.site!)
const i18n = t(locale)
const href = (sitePath: string) => localizePath(sitePath, locale)

const nav = [
  { label: i18n.writing, href: href('/') },
  { label: i18n.reading, href: href('/reading/') },
  { label: i18n.listening, href: href('/listening/') },
]

const isTool = path.startsWith('/d-sibs/') || path.startsWith('/stock-sell/')
const current = path.startsWith('/reading/')
  ? href('/reading/')
  : path.startsWith('/listening/')
    ? href('/listening/')
    : isTool
      ? ''
      : href('/')

const languageItems = localeTags.map((tag) => ({
  tag,
  name: endonym(tag),
  href: localizePath(path, tag),
}))

const footerLinks = [
  { label: i18n.writing, href: href('/') },
  { label: i18n.reading, href: href('/reading/') },
  { label: i18n.books, href: href('/reading/books/') },
  { label: i18n.listening, href: href('/listening/') },
  { label: i18n.rssFeed, href: href('/rss.xml') },
]

const copyright = `© ${new Date().getFullYear()} ${SITE_TITLE}. ${i18n.copyright}`
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <BaseHead
      title={title ?? SITE_TITLE}
      description={description ?? i18n.siteDescription}
      locale={locale}
      image={image}
      canonicalURL={canonicalURL}
      alternates={alternates}
    />
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <SiteHeader current={current} items={nav} home={href('/')}>
      <LanguageMenu current={locale} items={languageItems} label={i18n.language} class="max-sm:ml-auto" />
    </SiteHeader>

    <div id="main">
      <slot />
    </div>

    <SiteFooter links={footerLinks} copyright={copyright}>
      <LanguageIndex locale={locale} path={path} label={i18n.language} />
    </SiteFooter>

    <script define:vars={{ cookie: LOCALE_COOKIE }}>
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element && event.target.closest('a[data-locale]')
        if (link) {
          document.cookie = `${cookie}=${link.dataset.locale}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`
        }
      })
    </script>
  </body>
</html>
