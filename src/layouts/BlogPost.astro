---
import type { MarkdownHeading } from 'astro'
import FormattedDate from '../components/FormattedDate.astro'
import LanguageNote from '../components/LanguageNote.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import EdgeToc from '@zone/ui/components/EdgeToc.astro'
import SeriesPager from '@zone/ui/components/SeriesPager.astro'
import { localizePath, t } from '../i18n'
import type { LocalizedPost } from '../lib/posts'

type SeriesLink = { title: string; href: string; lang: string }

type Props = {
  entry: LocalizedPost
  headings?: MarkdownHeading[]
  series?: {
    id: string
    title: string
    lang: string
    position: number
    total: number
    prev?: SeriesLink
    next?: SeriesLink
  }
}

const { entry, headings = [], series } = Astro.props
const { locale, contentLang, title, description, post } = entry
const { pubDate, updatedDate } = post.data
const i18n = t(locale)

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label')
const hasSections = tocHeadings.some((h) => h.depth === 2)
const isFallback = !entry.available.includes(locale)
const isTranslation = Boolean(entry.translation)
const visibleNote = isFallback || isTranslation
const showNote = visibleNote || entry.available.length > 1
---

<BaseLayout
  locale={locale}
  path={`/blog/${post.id}/`}
  title={title}
  description={description}
  available={entry.available}
  sourceLocale={entry.sourceLocale}
  pageLayout="article"
  editorial
>
  <main class:list={['shell pb-page-bottom', visibleNote ? 'pt-10' : 'pt-article-top']}>
    <article class="mx-auto w-full max-w-reading">
      <header class="mb-8 border-b border-line pb-6">
        {showNote && (
          <LanguageNote
            locale={locale}
            path={`/blog/${post.id}/`}
            sourceLocale={entry.sourceLocale}
            available={entry.available}
            outdated={entry.outdated}
            placement="runhead"
          />
        )}
        <h1
          class="mt-0 font-prose text-heading-40 font-semibold text-ink max-sm:text-heading-32"
          lang={contentLang}
        >
          {title}
        </h1>
        {description && (
          <p class="mt-4 max-w-[56ch] font-prose text-lede-24 text-ink-secondary max-sm:text-copy-18" lang={contentLang}>
            {description}
          </p>
        )}
        <div class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-2 font-ui text-label-12 tabular-nums text-ink-tertiary">
          <time datetime={pubDate.toISOString()}>
            <FormattedDate date={pubDate} lang={locale} />
          </time>
          {series && (
            <span class="inline-flex flex-wrap items-baseline gap-2">
              <a
                class="text-accent underline decoration-accent/40 underline-offset-[0.2em] hover:decoration-current"
                href={localizePath(`/series/${series.id}/`, locale)}
                lang={series.lang}
              >
                {series.title}
              </a>
              <span class="text-ink-quiet" aria-hidden="true">·</span>
              <span>{i18n.seriesPartOf(series.position, series.total)}</span>
            </span>
          )}
          {updatedDate && (
            <span class="text-ink-quiet">
              {i18n.updatedOn} <FormattedDate date={updatedDate} lang={locale} />
            </span>
          )}
        </div>
      </header>

      <div class="z-prose z-prose--numbered" lang={contentLang}>
        <slot />
      </div>

      {series && (series.prev || series.next) && (
        <SeriesPager
          previous={series.prev}
          next={series.next}
          previousLabel={i18n.seriesPrev}
          nextLabel={i18n.seriesNext}
        />
      )}
    </article>
  </main>

  {hasSections && <EdgeToc headings={tocHeadings} label={i18n.tocLabel} />}
</BaseLayout>
