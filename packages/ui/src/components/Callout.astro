---
import { tv } from '../recipes/tv'
import { cn } from '../recipes/cn'

interface Props {
  label?: string
  kind?: 'note' | 'accent' | 'warning'
  class?: string
}

const callout = tv({
  slots: {
    root: 'grid grid-cols-[3.25rem_minmax(0,1fr)] gap-4 border-l-2 border-line-strong bg-surface px-5 py-4 font-ui max-[520px]:grid-cols-1 max-[520px]:gap-2',
    label: 'pt-0.5 text-label-11 uppercase text-ink-tertiary',
    body: 'font-prose text-copy-16 text-ink-secondary [&>*+*]:mt-3',
  },
  variants: {
    kind: {
      note: {},
      accent: {
        root: 'border-accent',
        label: 'text-accent',
      },
      warning: {
        root: 'border-warning',
        label: 'text-warning',
      },
    },
  },
  defaultVariants: { kind: 'note' },
})

const { label, kind = 'note', class: className } = Astro.props
const styles = callout({ kind })
---

<aside class={cn(styles.root(), !label && 'grid-cols-1 gap-0', className)}>
  {label && <p class={styles.label()}>{label}</p>}
  <div class={styles.body()}><slot /></div>
</aside>
