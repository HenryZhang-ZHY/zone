---
import { tv } from '../recipes/tv'
import { cn } from '../recipes/cn'

interface Props {
	/** The date column. The reading list has one; the episode row is its own component. */
	lead?: string
	/** `datetime` when the lead is a date. */
	datetime?: string
	title: string
	href: string
	/** Quiet facts before the source, e.g. `['E96', '面基']`. Joined with a middle dot. */
	meta?: string[]
	/** Where the link goes, e.g. `stanford.edu`. */
	source?: string
	lang?: string
	class?: string
}

const recordRow = tv({
	slots: {
		root: 'border-b border-line',
		link: 'group flex items-start gap-5 py-5 no-underline max-sm:gap-4 max-sm:py-4',
		body: 'min-w-0 flex-1',
		dated: 'grid grid-cols-[5.5rem_minmax(0,1fr)] items-baseline gap-x-6 max-sm:block',
		lead: 'whitespace-nowrap pt-[0.4em] font-ui text-label-12 tabular-nums text-ink-tertiary max-sm:block max-sm:pt-0 max-sm:pb-1',
		text: 'block min-w-0',
		title: 'block font-prose text-copy-18 font-medium text-ink underline decoration-transparent underline-offset-[0.18em] transition-[color,text-decoration-color] duration-1 ease-out group-hover:text-accent group-hover:decoration-current group-focus-visible:text-accent group-focus-visible:decoration-current',
		meta: 'mt-1.5 flex flex-wrap items-baseline gap-x-2 font-ui text-label-11 tracking-[0.04em] text-ink-tertiary',
		arrow: 'not-italic text-ink-quiet transition-[color,transform] duration-1 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent',
	},
})

const {
	lead,
	datetime,
	title,
	href,
	meta = [],
	source,
	lang,
	class: className,
} = Astro.props
const external = href.startsWith('http')
const styles = recordRow()
const facts = [...meta, ...(source ? [source] : [])].filter(Boolean)
---

<li class={cn(styles.root(), className)}>
	<a
		class={styles.link()}
		href={href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener noreferrer' : undefined}
	>
		<div class={lead ? styles.dated() : styles.body()}>
			{
				lead &&
					(datetime ? (
						<time class={styles.lead()} datetime={datetime}>{lead}</time>
					) : (
						<span class={styles.lead()}>{lead}</span>
					))
			}
			<span class={styles.text()} lang={lang}>
				<span class={styles.title()}>{title}</span>
				{
					facts.length > 0 && (
						<span class={styles.meta()}>
							{facts.map((fact, index) => (
								<>
									{index > 0 && <span aria-hidden="true">·</span>}
									<span>{fact}</span>
								</>
							))}
							<i class={styles.arrow()} aria-hidden="true">↗</i>
						</span>
					)
				}
			</span>
		</div>
	</a>
</li>
