---
import { tv } from '../recipes/tv'
import { cn } from '../recipes/cn'

interface Props {
  index?: string
  title: string
  href: string
  meta?: string
  class?: string
}

const listenRow = tv({
  slots: {
    root: 'group grid grid-cols-[2.25rem_minmax(0,1fr)_auto] font-ui items-baseline gap-4 border-t border-line py-4 last:border-b max-sm:grid-cols-[1.75rem_minmax(0,1fr)] max-sm:gap-3',
    index: 'text-label-11 tabular-nums text-ink-quiet',
    body: 'block min-w-0',
    title: 'block font-prose text-copy-16 text-ink group-hover:text-accent',
    meta: 'mt-0.5 block text-label-12 text-ink-tertiary',
    arrow: 'text-label-13 text-ink-quiet transition-[color,transform] duration-1 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent max-sm:hidden',
  },
})

const { index, title, href, meta, class: className } = Astro.props
const external = href.startsWith('http')
const styles = listenRow()
---

<a
  class={cn(styles.root(), className)}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {index && <span class={styles.index()}>{index}</span>}
  <span class={styles.body()}>
    <span class={styles.title()}>{title}</span>
    {meta && <span class={styles.meta()}>{meta}</span>}
  </span>
  <span class={styles.arrow()} aria-hidden="true">↗</span>
</a>
