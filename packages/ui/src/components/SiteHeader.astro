---
import { tv } from '../recipes/tv'
import Wordmark from './Wordmark.astro'
import { cn } from '../recipes/cn'

export interface NavItem {
  label: string
  href: string
}

interface Props {
  current?: string
  items?: NavItem[]
  home?: string
  class?: string
}

const header = tv({
  slots: {
    root: 'pt-6 font-ui max-sm:pt-4',
    inner: 'shell flex flex-wrap items-center gap-x-6',
    nav: 'ml-auto flex items-center gap-1 max-sm:ml-0 max-sm:mt-2 max-sm:w-full max-sm:border-t max-sm:border-line max-sm:pt-1',
    link: [
      'inline-flex min-h-10 items-center px-2 text-label-13 text-ink-tertiary',
      'underline decoration-transparent underline-offset-[0.35em] transition-[color,text-decoration-color] duration-1 ease-out',
      'hover:text-ink hover:decoration-line-strong',
      'aria-[current=page]:text-ink aria-[current=page]:decoration-signal aria-[current=page]:decoration-2',
      'max-sm:min-h-11',
    ],
    sep: 'text-label-11 leading-none text-ink-quiet select-none',
  },
})

const {
  current = '/',
  items = [
    { label: 'Writing', href: '/' },
    { label: 'Reading', href: '/reading/' },
    { label: 'Listening', href: '/listening/' },
  ],
  home = '/',
  class: className,
} = Astro.props

const styles = header()
---

<header class={cn(styles.root(), className)}>
  <div class={styles.inner()}>
    <Wordmark href={home} />
    <nav class={styles.nav()} aria-label="Primary">
      {
        items.map((item, index) => (
          <>
            {index > 0 && <span class={styles.sep()} aria-hidden="true">/</span>}
            <a
              class={styles.link()}
              href={item.href}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </>
        ))
      }
      <slot />
    </nav>
  </div>
</header>
