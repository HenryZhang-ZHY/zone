---
import { tv } from '../recipes/tv'
import { cn } from '../recipes/cn'

interface Props {
  href?: string
  tone?: 'default' | 'accent' | 'quiet'
  class?: string
}

const tag = tv({
  base: 'inline-flex items-center whitespace-nowrap border px-1.5 py-[3px] font-ui text-label-11 leading-none text-ink-tertiary',
  variants: {
    tone: {
      default: 'border-line bg-transparent',
      accent: 'border-accent/30 bg-accent-soft text-accent',
      quiet: 'border-transparent px-0',
    },
  },
  defaultVariants: { tone: 'default' },
})

const { href, tone = 'default', class: className } = Astro.props
const classes = cn(tag({ tone }), href && 'underline decoration-transparent underline-offset-[0.2em] hover:border-accent hover:text-accent', className)
---

{
  href ? (
    <a class={classes} href={href}><slot /></a>
  ) : (
    <span class={classes}><slot /></span>
  )
}
