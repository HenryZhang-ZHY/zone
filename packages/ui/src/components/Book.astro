---
import { tv } from '../recipes/tv'
import { cn } from '../recipes/cn'

interface Props {
  title: string
  href: string
  cover: string
  meta?: string
  loading?: 'lazy' | 'eager'
  class?: string
}

const book = tv({
  slots: {
    root: 'group flex min-w-0 flex-col font-ui',
    cover: 'block aspect-[2/3] overflow-hidden border border-line bg-surface transition-colors duration-1 ease-out group-hover:border-line-strong',
    image: 'h-full w-full object-cover',
    title: 'mt-3 block font-prose text-copy-14 font-medium leading-[1.45] text-ink [overflow-wrap:anywhere] group-hover:text-accent group-hover:underline group-hover:underline-offset-[0.18em]',
    meta: 'mt-1 block text-label-11 text-ink-tertiary',
  },
})

const { title, href, cover, meta, loading = 'lazy', class: className } = Astro.props
const external = href.startsWith('http')
const styles = book()
---

<a
  class={cn(styles.root(), className)}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class={styles.cover()}>
    <img class={styles.image()} src={cover} alt="" loading={loading} width="240" height="360" />
  </span>
  <span class={styles.title()}>{title}</span>
  {meta && <span class={styles.meta()}>{meta}</span>}
</a>
