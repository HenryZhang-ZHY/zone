---
import { cn } from '../recipes/cn'
import { branchMarks } from '../marks'

interface Props {
  variant?: number
  class?: string
}

const { variant = 1, class: className } = Astro.props
const mark = branchMarks[variant - 1] ?? branchMarks[0]
---

<svg
  class={cn('shrink-0', className)}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-mark={variant}
>
  {mark.paths.map((d) => <path d={d} />)}
</svg>
