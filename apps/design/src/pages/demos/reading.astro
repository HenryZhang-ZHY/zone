---
import DemoLayout from '../../components/DemoLayout.astro'
import RunningHead from '@zone/ui/components/RunningHead.astro'
import Book from '@zone/ui/components/Book.astro'
import { books } from '../../data/demo'
---

<DemoLayout
  title="Reading"
  description="The shelf demo for Hairline: books without a card grid."
  current="/demos/reading/"
>
  <div class="shell">
    <RunningHead label="The shelf" count={`${books.length} books`} />
    <section aria-labelledby="books" class="mt-8">
      <h2 id="books" class="sr-only">Books</h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-x-5 gap-y-8 max-sm:grid-cols-3 max-sm:gap-x-3 max-sm:gap-y-6">
        {books.map((book) => (
          <Book title={book.title} cover={book.cover} href={book.href} />
        ))}
      </div>
    </section>
  </div>
</DemoLayout>
