---
import DemoLayout from '../../components/DemoLayout.astro'
import PageHeader from '@zone/ui/components/PageHeader.astro'
import Book from '@zone/ui/components/Book.astro'
import { books } from '../../data/demo'
---

<DemoLayout
  title="Reading"
  description="The shelf demo for Hairline: books without a card grid."
  current="/demos/reading/"
>
  <div class="shell">
    <div class="mx-auto max-w-[66rem]">
      <PageHeader title="The shelf" class="mb-10" />
      <section aria-labelledby="books">
        <h2 id="books" class="sr-only">Books</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-x-6 gap-y-10 max-sm:grid-cols-2 max-sm:gap-x-4 max-sm:gap-y-8">
          {books.map((book) => (
            <Book title={book.title} cover={book.cover} href={book.href} />
          ))}
        </div>
      </section>
    </div>
  </div>
</DemoLayout>
