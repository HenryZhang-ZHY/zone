---
import DemoLayout from '../../components/DemoLayout.astro'
import RunningHead from '@zone/ui/components/RunningHead.astro'
import RecordRow from '@zone/ui/components/RecordRow.astro'
import { episodes } from '../../data/demo'
---

<DemoLayout
  title="Listening"
  description="The listening demo for Hairline: episode rows, no player chrome."
  current="/demos/listening/"
>
  <div class="shell">
    <div class="mx-auto max-w-measure">
      <RunningHead label="Listening" count="6 episodes" />
      <section aria-labelledby="episodes">
        <h2 id="episodes" class="sr-only">Episodes</h2>
        <ul class="m-0 list-none p-0">
          {episodes.map((episode) => (
            <RecordRow
              lead={episode.code}
              title={episode.title}
              href={episode.href}
              source={episode.source}
              kind="code"
            />
          ))}
        </ul>
      </section>
    </div>
  </div>
</DemoLayout>
